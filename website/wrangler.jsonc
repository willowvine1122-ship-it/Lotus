{
  // Cloudflare Workers static assets. Production name is lotus-website; previews deploy with
  // `npm run deploy:preview` (worker lotus-website-preview), never touching lotus-coming-soon.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lotus-website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
